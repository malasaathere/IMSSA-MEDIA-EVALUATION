FROM node:22-alpine

WORKDIR /usr/src/app

# Install curl for waiting/healthchecks
RUN apk add --no-cache curl

# Copy the infrastructure scripts and sheet data
COPY infra/appwrite ./infra/appwrite
COPY sheet_data.csv ./
COPY deploy/init.sh ./

# Install node dependencies
RUN cd infra/appwrite && npm install

CMD ["sh", "./init.sh"]
